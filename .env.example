NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=سامانه نوبت‌دهی
NEXT_PUBLIC_APP_TAGLINE=رزرو نوبت به‌صورت آنلاین
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=15000
NEXT_PUBLIC_PAYMENT_GATEWAY_ORIGINS=
# IANA timezone used when a response carries no timezone (must match the Backend business timezone).
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Tehran
# Display calendar: persian (Jalali, default) or gregorian. API values stay Gregorian ISO.
NEXT_PUBLIC_CALENDAR_SYSTEM=persian
SESSION_COOKIE_NAME=session
# Single-valued header the ingress in front of Next.js always overwrites with the client IP
# (e.g. x-real-ip). Forwarded to the Backend as X-Forwarded-For; the Backend honours it only when
# this server's address is in its TRUSTED_PROXY_IPS. Leave empty if no such ingress exists.
TRUSTED_CLIENT_IP_HEADER=
